# ==============================================================================
# ClipForge — environment configuration
# Copy this file to `.env`, adjust the secrets, then run `docker compose up -d`.
#   cp .env.example .env
# ==============================================================================

# ---- Application -------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.1.0

# ---- MySQL -------------------------------------------------------------------
MYSQL_DATABASE=clipforge
MYSQL_USER=clipforge
# CHANGE THESE before any real deployment.
MYSQL_PASSWORD=clipforge_dev
MYSQL_ROOT_PASSWORD=clipforge_root_dev

# SQLAlchemy URL (hostname matches the compose service name)
DATABASE_URL=mysql+pymysql://clipforge:clipforge_dev@clipforge-mysql:3306/clipforge?charset=utf8mb4

# ---- Redis -------------------------------------------------------------------
REDIS_URL=redis://clipforge-redis:6379/0

# ---- API ---------------------------------------------------------------------
# Bind address for the API port exposed on localhost (for local development).
# Set to 0.0.0.0:8000 only if you want it reachable from the network.
API_BIND=127.0.0.1:8000
CORS_ORIGINS=http://localhost,http://localhost:5173

# ---- HTTP entry point --------------------------------------------------------
HTTP_PORT=80
# Where the OAuth callback redirects the browser after connecting a Google
# account (must match the redirect URI registered in Google Cloud Console).
FRONTEND_PUBLIC_URL=http://localhost:8080

# ---- Storage / Google Drive (Phase 2) -----------------------------------------
STORAGE_PROVIDER=google_drive
GOOGLE_DRIVE_ROOT_FOLDER=ClipForge
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Enable the Google Drive API. Redirect URI: <FRONTEND_PUBLIC_URL>/api/google-drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# How often the worker polls the Drive inbox for new files (seconds).
DRIVE_POLL_INTERVAL=60
# Fernet key for encrypting OAuth tokens at rest (base64, 32 bytes).
# Generate with:  docker compose exec clipforge-api python -m app.core.crypto
TOKEN_ENCRYPTION_KEY=

# ---- Processing --------------------------------------------------------------
TEMP_STORAGE_PATH=/data/temp
TEMP_FILE_RETENTION_HOURS=24

# ---- Transcription (Phase 4) --------------------------------------------------
TRANSCRIPTION_PROVIDER=local
WHISPER_MODEL=base
# Empty = auto-detect language. Set e.g. en/id for a specific language.
WHISPER_LANGUAGE=
# Silero VAD filter — keep false: its LSTM state drifts on long music/silence
# passages and silently returns an empty transcript (see config.py).
WHISPER_VAD_FILTER=false

# ---- AI analysis (Phase 5) -----------------------------------------------------
# deepseek = real API (requires DEEPSEEK_API_KEY); mock = deterministic offline
# candidates for demos/tests without a key.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MAX_CLIPS_PER_VIDEO=5

# ---- Rendering (Phase 6) ---------------------------------------------------------
# Output resolution for Shorts (9:16).
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
# x264 encoding quality: lower CRF = better quality but slower encodes.
RENDER_CRF=23
RENDER_PRESET=veryfast
RENDER_AUDIO_BITRATE=128k
# Verify rendered files with ffprobe before marking a clip as rendered.
RENDER_QUALITY_CHECK=true
RENDER_TIMEOUT_SECONDS=1800

# ---- Background music (Phase 11) --------------------------------------------------
# Mix a music track under the original audio of every rendered Short.
BACKGROUND_MUSIC=false
# Directory with music tracks (mp3/wav/ogg/m4a/flac/aac/opus). Empty =
# <TEMP_STORAGE_PATH>/music. Each candidate picks one track deterministically
# (same clip always re-renders identically); a bad track falls back to no music.
BACKGROUND_MUSIC_PATH=
# Music level relative to the original audio (0.0–1.0).
BACKGROUND_MUSIC_VOLUME=0.15

# ---- YouTube publishing (Phase 8-9) ---------------------------------------------
# Publishing backend (youtube is the only provider today).
PUBLISHING_PROVIDER=youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console.
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/youtube/callback
# Videos uploaded without an explicit privacy choice use this value.
# Scheduling always forces private (YouTube publishAt requirement).
YOUTUBE_DEFAULT_PRIVACY=private

# ---- Automation (Phase 10 — Drop & Forget) ------------------------------------
# With AUTO_APPROVE=true the worker runs the pipeline end-to-end without the
# dashboard: download/import → transcribe → analyze → auto-approve → render.
# Only the best candidate is auto-approved, and only when its overall score
# reaches AUTO_APPROVE_THRESHOLD; weaker clips stay for manual review.
AUTO_APPROVE=false
AUTO_APPROVE_THRESHOLD=85
# With YOUTUBE_AUTO_PUBLISH=true every successfully rendered Short is uploaded
# automatically (privacy per YOUTUBE_DEFAULT_PRIVACY; requires a connected
# YouTube channel).
YOUTUBE_AUTO_PUBLISH=false

# ---- Worker (Phase 10) ----------------------------------------------------------
# How many jobs may run at once (keep 1 on the Orange Pi — Whisper/FFmpeg are
# memory-heavy) and how many times an unexpectedly failing job is retried
# with exponential backoff (5s → 10s → 20s → … capped at 5 min).
MAX_CONCURRENT_JOBS=1
MAX_JOB_RETRIES=3
